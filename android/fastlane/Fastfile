# Fastfile for Android
# This file contains the fastlane.tools configuration
default_platform(:android)

platform :android do
  desc "Run Patrol integration tests on Android"
  lane :test do
    # Install dependencies
    sh("cd ../.. && flutter pub get")

    package_name = "com.thinslices.solarisdemo"
    
    # Uninstall any existing version first to ensure clean state
    UI.message("🧹 Uninstalling any existing app version...")
    sh("adb uninstall #{package_name} 2>/dev/null || true")
    
    # Verify app is removed
    sleep(2)
    if sh("adb shell pm list packages | grep #{package_name} || echo 'not found'", log: false).include?('not found')
      UI.success("✅ App successfully uninstalled")
    else
      UI.important("⚠️  App may still be present, but continuing...")
    end
    
    # Start the permission granting script in the background with visible output
    # This script will wait for the app to be installed and then grant permissions
    UI.message("🚀 Starting background permission granting script...")
    
    # Create a log file for the permission script
    log_file = "../../permission_grant.log"
    permission_pid = Process.spawn(
      "bash", "../grant_permissions.sh",
      out: log_file,
      err: log_file
    )
    Process.detach(permission_pid)
    UI.success("✅ Permission granting script started (PID: #{permission_pid})")
    UI.message("   Log file: #{log_file}")

    # Give the background script a moment to start
    sleep(1)

    # Run Patrol tests - this will build, install, and run tests
    # The background script will grant permissions after installation
    UI.message("🧪 Running Patrol tests (permissions will be granted automatically)...")
    UI.message("   The background script is monitoring for app installation...")
    
    begin
      sh("cd ../.. && patrol test android --verbose")
    rescue => ex
      UI.error("❌ Patrol test failed!")
      UI.error("Error: #{ex.message}")
      
      # Show permission grant log
      UI.message("📋 Permission grant script output:")
      begin
        log_content = File.read("../../permission_grant.log")
        UI.message(log_content)
      rescue
        UI.message("Could not read permission grant log")
      end
      
      UI.message("📋 Collecting device logs for debugging...")
      sh("adb logcat -d > ../../android_test_logcat.txt || true")
      
      # Try to kill the background process
      begin
        Process.kill("TERM", permission_pid)
        UI.message("Stopped background permission script")
      rescue
        # Process might have already exited
      end
      
      raise ex
    end

    # Try to kill the background process if it's still running
    begin
      Process.kill("TERM", permission_pid)
      UI.message("Stopped background permission script")
    rescue
      # Process might have already exited
    end
    
    # Show permission grant log
    UI.message("📋 Permission grant script final output:")
    begin
      log_content = File.read("../../permission_grant.log")
      UI.message(log_content)
    rescue
      UI.message("Could not read permission grant log")
    end

    UI.success("✅ Android Patrol tests completed!")
  end

  desc "Build Android release APK"
  lane :build_release do
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("cd ../.. && flutter build apk --release")

    UI.success("✅ Release APK built!")
    UI.message("APK: build/app/outputs/flutter-apk/app-release.apk")
  end

  desc "Build APKs only (without running tests)"
  lane :build_apks do
    # Install dependencies
    sh("cd ../.. && flutter pub get")

    # Build APKs with Patrol (for uploading to Firebase Test Lab, etc.)
    sh("cd ../.. && patrol build android --verbose")

    UI.success("✅ Android test APKs built successfully!")
    UI.message("App APK: build/app/outputs/apk/debug/app-debug.apk")
    UI.message("Test APK: build/app/outputs/apk/androidTest/debug/app-debug-androidTest.apk")
  end

  desc "Build and deploy to internal testing"
  lane :deploy_internal do
    build_release

    # TODO: Add Play Store upload when ready
    # upload_to_play_store(
    #   track: 'internal',
    #   apk: '../build/app/outputs/flutter-apk/app-release.apk'
    # )

    UI.success("✅ Ready for internal deployment!")
  end
end